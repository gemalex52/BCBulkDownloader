{
  "manifest_version": 3,
  "name": "Bandcamp Free & NYP Bulk Downloader",
  "version": "2.0.0",
  "description": "Bulk download Bandcamp discographies: true lossless studio FLAC, companion (info).zip with untruncated info.txt, cover.jpg, artist.jpg, photos/, and lyrics, Gmail watchdog, and anti-captcha pacing.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bandcamp.com/*",
    "*://*.bcbits.com/*",
    "*://script.google.com/*",
    "*://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bandcamp Bulk Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bandcamp.com/*",
        "*://bandcamp.com/*"
      ],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}